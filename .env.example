# Never commit real credentials or tokens.
# Production deployment will explicitly set SITE_INDEXABLE=true only after separate approval.
# Keep preview/local environments non-indexable unless intentionally testing crawlability.

SITE_INDEXABLE=false

# Bootstrap-only root-of-trust configuration.
# WIDEORDER_ADMIN_PASSWORD_HASH is only for first-time admin bootstrap and explicit recovery.
WIDEORDER_ADMIN_PASSWORD_HASH=
WIDEORDER_CONFIG_ENCRYPTION_KEY=
WIDEORDER_DATABASE_URL=
WIDEORDER_LOCAL_CONFIG_DB_PATH=.data/wideorder-managed-config.sqlite

# Bootstrap defaults for managed operational settings.
# These may be replaced later in persistent managed storage without a rebuild or redeploy.
# Transactional email should use Resend in production once the domain is verified.
RESEND_API_KEY=
TRANSACTIONAL_FROM_EMAIL=website@wideorder.net
CONTACT_RECIPIENT_EMAIL=info@wideorder.net

# Legacy SMTP settings are retained temporarily for rollback/reference during migration.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=website@wideorder.net
SMTP_PASSWORD=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
