# Never commit real credentials or tokens.
# Production deployment will explicitly set SITE_INDEXABLE=true only after separate approval.
# Keep preview/local environments non-indexable unless intentionally testing crawlability.

SITE_INDEXABLE=false

# Bootstrap-only root-of-trust configuration.
# WIDEORDER_ADMIN_PASSWORD_HASH is only for first-time admin bootstrap and explicit recovery.
WIDEORDER_ADMIN_PASSWORD_HASH=
WIDEORDER_CONFIG_ENCRYPTION_KEY=
WIDEORDER_DATABASE_URL=
WIDEORDER_LOCAL_CONFIG_DB_PATH=.data/wideorder-managed-config.sqlite

# Bootstrap defaults for managed operational settings.
# These may be replaced later in persistent managed storage without a rebuild or redeploy.
# Transactional email should use Resend in production once the domain is verified.
RESEND_API_KEY=
TRANSACTIONAL_FROM_EMAIL=website@wideorder.net
CONTACT_RECIPIENT_EMAIL=info@wideorder.net

# Legacy SMTP settings are retained temporarily for rollback/reference during migration.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=website@wideorder.net
SMTP_PASSWORD=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional marketing (runtime /api/marketing-config; all off until configured and consented).
# IDs below are public tag identifiers, not access tokens. Never add private API tokens here.
MARKETING_TRACKING_ENABLED=false
MARKETING_GA4_ENABLED=false
MARKETING_GA4_ID=
MARKETING_GTM_ENABLED=false
MARKETING_GTM_ID=
MARKETING_LINKEDIN_ENABLED=false
MARKETING_LINKEDIN_ID=
MARKETING_LINKEDIN_LEAD_CONVERSION=
MARKETING_META_ENABLED=false
MARKETING_META_ID=
MARKETING_GOOGLE_ADS_ENABLED=false
MARKETING_GOOGLE_ADS_ID=
MARKETING_GOOGLE_ADS_LABEL=
MARKETING_X_ENABLED=false
MARKETING_X_ID=
MARKETING_X_LEAD_EVENT=
GOOGLE_SITE_VERIFICATION=

# Publish only after an owner verifies each URL. No placeholder social links are rendered.
SOCIAL_LINKEDIN_VERIFIED=false
SOCIAL_LINKEDIN_URL=
SOCIAL_YOUTUBE_VERIFIED=false
SOCIAL_YOUTUBE_URL=
SOCIAL_FACEBOOK_VERIFIED=false
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_VERIFIED=false
SOCIAL_INSTAGRAM_URL=
SOCIAL_X_VERIFIED=false
SOCIAL_X_URL=
