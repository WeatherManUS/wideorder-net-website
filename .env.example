# Never commit real credentials or tokens.
# Production deployment will explicitly set SITE_INDEXABLE=true.
# Keep preview/local environments non-indexable unless intentionally testing crawlability.

SITE_INDEXABLE=false

# Server-only contact delivery configuration.
# CONTACT_RECIPIENT_EMAIL will ultimately be hello@wideorder.net.
# CONTACT_FROM_EMAIL must use a verified sending identity before launch.
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=

# Public Turnstile site key for the browser widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
